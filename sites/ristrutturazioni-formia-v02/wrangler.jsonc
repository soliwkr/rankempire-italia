{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ristrutturazioni-formia-web",
  "compatibility_date": "2026-10-25",
  "main": "./src/index.mjs",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash"
  },
  "observability": {
    "enabled": true
  }
}
